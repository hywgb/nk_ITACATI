# 后端 PJSUA2 示例配置
# 监听端口
ITACATI_SIP_PORT=5060
ITACATI_SIP_TCP_PORT=5060
# 开启 TLS（非空即启用），并设置 TLS 端口
# ITACATI_SIP_TLS=1
# ITACATI_SIP_TLS_PORT=5061

# 可选注册到上游SIP服务器
# 例如 用户 alice@pbx.example.com 在上游注册
# ITACATI_SIP_USER=alice
# ITACATI_SIP_DOMAIN=pbx.example.com
# ITACATI_SIP_PASS=yourpassword
# 可选代理（如需 TCP/特定路由）
# ITACATI_SIP_PROXY=sip:pbx.example.com;transport=tcp